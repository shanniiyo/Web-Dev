    <script>
      /*
       * ================================================================
       * FLIGHT SEARCH — CLIENT-SIDE JAVASCRIPT
       * ================================================================
       * This script performs the AJAX requirement 
       * It sends Origin, Destination, and Departure Date to the db, 
       * only the results section without refreshing the whole page.
       */

      // Stores the latest flights returned by the server.
      // The sidebar filters and sorting controls use this array.
      var searchedFlights = [];

      /*
       * SEARCH BUTTON EVENT
       */
      $("#searchBtn").click(function () {
        // Read the typed search values from the form
        // trim() removes accidental spaces before or after the text.
        var origin = $("#origin").val().trim();
        var destination = $("#destination").val().trim();
        var departureDate = $("#departureDate").val();

        // Read passenger inputs for front-end validation/documentation.
        var adults = Number($("#adultPassengers").val());
        var children = Number($("#childPassengers").val());
        var infants = Number($("#infantPassengers").val());

        // Prevent an incomplete request from being sent to the server.
        if (origin === "" || destination === "" || departureDate === "") {
          alert("Please enter an origin, destination, and departure date.");
          return;
        }

        // A route cannot start and end at the same location
        // toLowerCase() makes this comparison case-insensitive
        if (origin.toLowerCase() === destination.toLowerCase()) {
          alert("Origin and destination cannot be the same.");
          return;
        }

        // Validate the chosen passenger quantities
        if (adults < 1 || children < 0 || infants < 0) {
          alert("Please enter valid passenger quantities.");
          return;
        }

        // Reveal the existing results and show a loading message
        $("#flightResults").removeClass("d-none");
        $("#flightCards").empty();
        $("#searchStatus")
          .removeClass("d-none alert-danger alert-warning")
          .addClass("alert-info")
          .text("Searching for available flights...");

        /*
         * Build the API URL using query-string parameters.
         * encodeURIComponent() makes typed text safe to include in a URL,
         * especially when locations contain spaces or special characters.
         */
        var searchUrl =
          "/api/flights/search?origin=" +
          encodeURIComponent(origin) +
          "&destination=" +
          encodeURIComponent(destination) +
          "&departureDate=" +
          encodeURIComponent(departureDate);

        /*
         * AJAX REQUEST USING FETCH
         * fetch() sends a GET request without refreshing the page.
         */
        fetch(searchUrl)
          .then(function (response) {
            //errors are checked manually here
            if (!response.ok) {
              throw new Error("The server could not complete the search.");
            }

            // Convert the server's JSON response into JavaScript data
            return response.json();
          })
          .then(function (flights) {
            // Save the original results so filters can reuse them locally
            searchedFlights = flights;

            // Apply sidebar filters, sorting, and render the cards
            applyResultFilters();

            // Move the page to the results section for better usability.
            $("html, body").animate(
              {
                scrollTop: $("#flightResults").offset().top - 90,
              },
              400
            );
          })
          .catch(function (error) {
            // Handle network errors or server errors
            console.error(error);
            $("#flightCards").empty();
            $("#searchStatus")
              .removeClass("d-none alert-info alert-warning")
              .addClass("alert-danger")
              .text("Unable to search flights. Please try again.");
          });
      });

      /*
       * APPLY RESULT FILTERS AND SORTING
       * Filters only the data already returned by db
       */
      function applyResultFilters() {
        var airline = $("#airlineFilter").val();
        var priceRange = $("#priceFilter").val();
        var departurePeriod = $("#departureTimeFilter").val();
        var sortBy = $("#sortFlights").val();

        // filter() creates a new array containing only matching flights.
        var filteredFlights = searchedFlights.filter(function (flight) {
          var matchesAirline =
            airline === "All" || flight.airline === airline;

          // Convert ticketPrice to Number before doing numeric comparisons.
          var matchesPrice = true;
          var price = Number(flight.ticketPrice);

          if (priceRange === "0-5000") {
            matchesPrice = price <= 5000;
          } else if (priceRange === "5000-10000") {
            matchesPrice = price > 5000 && price <= 10000;
          } else if (priceRange === "10000+") {
            matchesPrice = price > 10000;
          }

          // Extract the departure hour so Morning/Afternoon/Evening
          // can be checked using the passenger's selected filter.
          var departureHour = new Date(
            flight.departureDateTime
          ).getHours();

          var matchesDeparture = true;

          if (departurePeriod === "Morning") {
            matchesDeparture =
              departureHour >= 5 && departureHour < 12;
          } else if (departurePeriod === "Afternoon") {
            matchesDeparture =
              departureHour >= 12 && departureHour < 18;
          } else if (departurePeriod === "Evening") {
            matchesDeparture =
              departureHour >= 18 || departureHour < 5;
          }

          return matchesAirline && matchesPrice && matchesDeparture;
        });

        // sort() changes the order of the filtered flights.
        filteredFlights.sort(function (firstFlight, secondFlight) {
          if (sortBy === "departure") {
            return (
              new Date(firstFlight.departureDateTime) -
              new Date(secondFlight.departureDateTime)
            );
          }

          if (sortBy === "duration") {
            return (
              getDurationMinutes(firstFlight) -
              getDurationMinutes(secondFlight)
            );
          }

          // Default order: lowest ticket price first.
          return (
            Number(firstFlight.ticketPrice) -
            Number(secondFlight.ticketPrice)
          );
        });

        displayFlights(filteredFlights);
      }

      /*
       * DISPLAY FLIGHTS
       * creates  cards using flight documents returned by db. 
       */
      function displayFlights(flights) {
        // Remove previous cards before displaying the latest result set.
        $("#flightCards").empty();

        // Show a message instead of leaving a blank result area.
        if (flights.length === 0) {
          $("#searchStatus")
            .removeClass("d-none alert-info alert-danger")
            .addClass("alert-warning")
            .text("No available flights matched your search.");
          return;
        }

        $("#searchStatus").addClass("d-none");

        // forEach() repeats the card for every flight.
        flights.forEach(function (flight, index) {
          var departure = new Date(flight.departureDateTime);
          var arrival = new Date(flight.arrivalDateTime);

          // Each collapse panel needs a unique ID.
          var detailId = "flightDetail" + index;

          var logoPath = getAirlineLogo(flight.airline);
          var duration = formatDuration(getDurationMinutes(flight));
          var price = Number(flight.ticketPrice).toLocaleString("en-PH", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          });

          /*
           * Build the card using string concatenation.
           * Values come from the flight document returned from db
           */
          var card =
            '<div class="col-md-12">' +
              '<div class="card flight-card">' +
                '<div class="card-body">' +
                  '<div class="row align-items-center">' +

                    '<div class="col-md-2 text-center">' +
                      '<img class="airline-logo" src="' +
                        logoPath +
                        '" alt="' +
                        escapeHtml(flight.airline) + //escapeHtml() is a security function. It prevents text coming from the database from being interpreted as HTML or JavaScript by the browser.
                        '">' +
                      '<small class="d-block mt-2">' +
                        escapeHtml(flight.airline) +
                      '</small>' +
                    '</div>' +

                    '<div class="col-md-2">' +
                      '<h6>' +
                        escapeHtml(flight.flightNumber) +
                      '</h6>' +
                      formatTime(departure) +
                      ' → ' +
                      formatTime(arrival) +
                    '</div>' +

                    '<div class="col-md-2">' +
                      duration +
                    '</div>' +

                    '<div class="col-md-2">' +
                      escapeHtml(flight.origin) +
                      '<br>' +
                      '<small>to</small>' +
                      '<br>' +
                      escapeHtml(flight.destination) +
                    '</div>' +

                    '<div class="col-md-2">' +
                      '₱' +
                      price +
                      '<br>' +
                      '<small>' +
                        flight.availableSeats +
                        ' seats left' +
                      '</small>' +
                    '</div>' +

                    '<div class="col-md-2">' +
                      '<a href="/booking?flightId=' +
                        encodeURIComponent(flight._id) +
                        '" class="btn btn-success w-100" role="button">' +
                        'Book Flight' +
                      '</a>' +
                    '</div>' +

                  '</div>' +

                  '<div class="mt-3">' +
                    '<button class="btn btn-outline-secondary btn-sm" ' +
                      'data-bs-toggle="collapse" ' +
                      'data-bs-target="#' +
                      detailId +
                      '">' +
                      'View Details' +
                    '</button>' +

                    '<div class="collapse mt-2" id="' +
                      detailId +
                      '">' +
                      '<div class="card card-body">' +
                        '<div class="row g-2">' +
                          '<div class="col-md-6">' +
                            '<strong>Flight Number:</strong> ' +
                            escapeHtml(flight.flightNumber) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Airline:</strong> ' +
                            escapeHtml(flight.airline) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Origin:</strong> ' +
                            escapeHtml(flight.origin) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Destination:</strong> ' +
                            escapeHtml(flight.destination) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Departure:</strong> ' +
                            formatDateTime(departure) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Arrival:</strong> ' +
                            formatDateTime(arrival) +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Available Seats:</strong> ' +
                            flight.availableSeats +
                          '</div>' +
                          '<div class="col-md-6">' +
                            '<strong>Ticket Price:</strong> ₱' +
                            price +
                          '</div>' +
                        '</div>' +
                      '</div>' +
                    '</div>' +
                  '</div>' +

                '</div>' +
              '</div>' +
            '</div>';

          // Add the completed card to the results container.
          $("#flightCards").append(card);
        });
      }

      /* Calculate flight duration in minutes using arrival minus departure. */
      function getDurationMinutes(flight) {
        var departure = new Date(flight.departureDateTime);
        var arrival = new Date(flight.arrivalDateTime);

        return Math.max(
          0,
          Math.round((arrival - departure) / 60000)
        );
      }

      /* Convert total minutes into a readable format such as 1h 30m. */
      function formatDuration(totalMinutes) {
        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;

        return hours + "h " + minutes + "m";
      }

      /* Format a Date object as time only. */
      function formatTime(date) {
        return date.toLocaleTimeString("en-PH", {
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      /* Format a Date object with both date and time for View Details. */
      function formatDateTime(date) {
        return date.toLocaleString("en-PH", {
          dateStyle: "medium",
          timeStyle: "short",
        });
      }

      /* Select an airline image based on the airline name from MongoDB. */
      function getAirlineLogo(airline) {
        var airlineName = airline.toLowerCase();

        if (
          airlineName.indexOf("philippine") !== -1 ||
          airlineName === "pal"
        ) {
          return "/images/PAL.jpg";
        }

        if (airlineName.indexOf("cebu") !== -1) {
          return "/images/CEBPAC.jpeg";
        }

        if (
          airlineName.indexOf("airasia") !== -1 ||
          airlineName.indexOf("air asia") !== -1
        ) {
          return "/images/AirAsia.png";
        }

        if (
          airlineName.indexOf("japan") !== -1 ||
          airlineName === "jal"
        ) {
          return "/images/JAL.png";
        }

        // Back up image
        return "/images/Airplane.jpeg";
      }

      function escapeHtml(value) { //escapeHtml() is a security function. It prevents text coming from the database from being interpreted as HTML or JavaScript by the browser.
        return $("<div>").text(value || "").html();
      }

      // Re-filter and re-sort the current results when a
      // sidebar control changes. 
      $("#airlineFilter, #priceFilter, #departureTimeFilter, #sortFlights")
        .on("change", function () {
          applyResultFilters();
        });

      // Update the displayed maximum budget while the slider is moved.
      document
        .getElementById("priceRange")
        .addEventListener("input", function () {
          document.getElementById("priceValue").innerText =
            "₱" + this.value;
        });

        /*
       * SEARCH AFTER REDIRECT FROM index.hbs
       * ================================================================
       * Reads Origin, Destination, and Departure Date from the URL,
       * fills the search form, and reuses the existing Search button
       */
      $(document).ready(function () {
        var urlParameters = new URLSearchParams(window.location.search);

        var originFromHome = urlParameters.get("origin");
        var destinationFromHome = urlParameters.get("destination");
        var departureDateFromHome = urlParameters.get("departureDate");

        if (
          originFromHome &&
          destinationFromHome &&
          departureDateFromHome
        ) {
          $("#origin").val(originFromHome);
          $("#destination").val(destinationFromHome);
          $("#departureDate").val(departureDateFromHome);

          // Trigger the existing AJAX search automatically.
          $("#searchBtn").trigger("click");
        }
      });

    </script>
  </body>
</html>

