<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flight Management | FlyScanners Admin</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design.css" />
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">FlyScanners — Admin</a>
      <a class="btn btn-outline-light btn-sm" href="/">Exit Admin</a>
    </div>
  </nav>

  <div class="d-flex">
    <nav class="admin-sidebar bg-light p-3" style="width: 220px; min-height: calc(100vh - 56px)">
      <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link active" href="/admin/flights">Flights</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/users">Users</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/reservations">Reservations</a></li>
      </ul>
    </nav>

    <main class="flex-grow-1 p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Flight Management</h2>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addFlightModal">
          + Add Flight
        </button>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Flight No.</th>
              <th>Airline</th>
              <th>Origin</th>
              <th>Destination</th>
              <th>Departure</th>
              <th>Arrival</th>
              <th>Price (₱)</th>
              <th>Seats</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
  {{#each flights}}
  <tr>
    <td>{{this.flightNumber}}</td>
    <td>{{this.airline}}</td>
    <td>{{this.origin}}</td>
    <td>{{this.destination}}</td>
    <td>{{formatDate this.departureDateTime}}</td>
    <td>{{formatDate this.arrivalDateTime}}</td>
    <td>{{this.ticketPrice}}</td>
    <td>{{this.availableSeats}}</td>
    <td>
      <button class="btn btn-sm btn-outline-primary edit-flight-btn"
        data-bs-toggle="modal"
        data-bs-target="#editFlightModal"
        data-id="{{this._id}}"
        data-flightnumber="{{this.flightNumber}}"
        data-airline="{{this.airline}}"
        data-origin="{{this.origin}}"
        data-destination="{{this.destination}}"
        data-departure="{{this.departureDateTime}}"
        data-arrival="{{this.arrivalDateTime}}"
        data-seats="{{this.availableSeats}}"
        data-price="{{this.ticketPrice}}">
        Edit
      </button>
      <form action="/admin/flights/{{this._id}}/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this flight?');">
        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
      </form>
    </td>
  </tr>
  {{else}}
  <tr><td colspan="9" class="text-center text-muted">No flights yet. Click "+ Add Flight" to create one.</td></tr>
  {{/each}}
</tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Add Flight Modal -->
  <div class="modal fade" id="addFlightModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/admin/flights" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Add Flight</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Flight Number</label>
              <input type="text" class="form-control" name="flightNumber" placeholder="e.g. PR101" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Airline</label>
              <input type="text" class="form-control" name="airline" placeholder="e.g. Philippine Airlines" required />
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Origin</label>
                <input type="text" class="form-control" name="origin" placeholder="e.g. Manila" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Destination</label>
                <input type="text" class="form-control" name="destination" placeholder="e.g. Cebu" required />
              </div>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Departure Date/Time</label>
                <input type="datetime-local" class="form-control" name="departureDateTime" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Arrival Date/Time</label>
                <input type="datetime-local" class="form-control" name="arrivalDateTime" required />
              </div>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Price (₱)</label>
                <input type="number" class="form-control" name="ticketPrice" min="0" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Available Seats</label>
                <input type="number" class="form-control" name="availableSeats" min="0" required />
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Flight Modal -->
  <div class="modal fade" id="editFlightModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="editFlightForm" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Edit Flight</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Flight Number</label>
              <input type="text" class="form-control" name="flightNumber" id="edit-flightNumber" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Airline</label>
              <input type="text" class="form-control" name="airline" id="edit-airline" required />
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Origin</label>
                <input type="text" class="form-control" name="origin" id="edit-origin" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Destination</label>
                <input type="text" class="form-control" name="destination" id="edit-destination" required />
              </div>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Departure Date/Time</label>
                <input type="datetime-local" class="form-control" name="departureDateTime" id="edit-departure" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Arrival Date/Time</label>
                <input type="datetime-local" class="form-control" name="arrivalDateTime" id="edit-arrival" required />
              </div>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Price (₱)</label>
                <input type="number" class="form-control" name="ticketPrice" id="edit-price" min="0" required />
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Available Seats</label>
                <input type="number" class="form-control" name="availableSeats" id="edit-seats" min="0" required />
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <footer><p>© FlyScanners</p></footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.querySelectorAll(".edit-flight-btn").forEach((btn) => {
      btn.addEventListener("click", function () {
        const id = this.dataset.id;
        document.getElementById("editFlightForm").action = "/admin/flights/" + id + "/update";
        document.getElementById("edit-flightNumber").value = this.dataset.flightnumber;
        document.getElementById("edit-airline").value = this.dataset.airline;
        document.getElementById("edit-origin").value = this.dataset.origin;
        document.getElementById("edit-destination").value = this.dataset.destination;
        document.getElementById("edit-departure").value = this.dataset.departure;
        document.getElementById("edit-arrival").value = this.dataset.arrival;
        document.getElementById("edit-seats").value = this.dataset.seats;
        document.getElementById("edit-price").value = this.dataset.price;
      });
    });
  </script>
</body>
</html>