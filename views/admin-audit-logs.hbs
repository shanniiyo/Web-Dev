<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Audit Trail | FlyScanners Admin</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/design.css" />
  </head>

  <body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">FlyScanners — Admin</a>
        <a class="btn btn-outline-light btn-sm" href="/">Exit Admin</a>
      </div>
    </nav>

    <div class="d-flex">
      <!-- Sidebar -->
      <nav
        class="admin-sidebar bg-light p-3"
        style="width: 220px; min-height: calc(100vh - 56px)"
      >
        <ul class="nav nav-pills flex-column gap-1">
          <li class="nav-item">
            <a class="nav-link" href="/admin-dashboard">Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin-flights">Flights</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin-users">Users</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin-reservations">Reservations</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin-audit-logs">Audit Logs</a>
          </li>
        </ul>
      </nav>

      <!-- Main Content -->
      <main class="flex-grow-1 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Audit Trail</h2>
          <span class="text-muted small">{{logs.length}} record(s)</span>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
              <tr>
                <th>Date &amp; Time</th>
                <th>Username</th>
                <th>Role</th>
                <th>Activity</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {{#each logs}}
              <tr>
                <td>{{formatDate this.timestamp}}</td>
                <td>{{this.username}}</td>
                <td>
                  <span
                    class="badge {{#if (eq this.role "admin")}}bg-danger{{else}}bg-secondary{{/if}}"
                  >
                    {{this.role}}
                  </span>
                </td>
                <td>{{this.activity}}</td>
                <td>{{this.details}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="5" class="text-center text-muted">
                  No audit trail activity has been recorded yet.
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <!-- Footer -->
    <footer>
      <p>© FlyScanners</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
