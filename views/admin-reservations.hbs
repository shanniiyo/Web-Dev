<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reservation Management | FlyScanners Admin</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design.css" />
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">FlyScanners — Admin</a>
      <a class="btn btn-outline-light btn-sm" href="/">Exit Admin</a>
    </div>
  </nav>

  <div class="d-flex">
    <nav class="admin-sidebar bg-light p-3" style="width: 220px; min-height: calc(100vh - 56px)">
      <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/flights">Flights</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/users">Users</a></li>
        <li class="nav-item"><a class="nav-link active" href="/admin/reservations">Reservations</a></li>
      </ul>
    </nav>

    <main class="flex-grow-1 p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Reservation Management</h2>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Booking Ref</th>
              <th>Passenger</th>
              <th>Flight No.</th>
              <th>Seat</th>
              <th>Total Price (₱)</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="reservationsTableBody">
            {{#each reservations}}
            <tr data-id="{{this._id}}">
              <td>{{this.reservationNumber}}</td>
              <td>{{this.passengerName}}</td>
              <td>{{this.flightNumber}}</td>
              <td>{{this.seatNumber}}</td>
              <td>₱{{this.totalPrice}}</td>
              <td class="status-cell">{{this.bookingStatus}}</td>
              <td>
                {{#unless (eq this.bookingStatus "Cancelled")}}
                <button class="btn btn-sm btn-outline-danger cancel-btn" data-id="{{this._id}}">
                  Cancel
                </button>
                {{else}}
                <button class="btn btn-sm btn-outline-secondary" disabled>Cancelled</button>
                {{/unless}}
              </td>
            </tr>
            {{else}}
            <tr><td colspan="7" class="text-center text-muted">No reservations yet.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <footer><p>© FlyScanners</p></footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.querySelectorAll(".cancel-btn").forEach((btn) => {
      btn.addEventListener("click", async function () {
        if (!confirm("Cancel this reservation?")) return;
        const id = this.dataset.id;

        try {
          const res = await fetch("/api/reservations/" + id + "/cancel", {
            method: "POST",
          });
          const data = await res.json();

          if (!res.ok) {
            alert(data.error || "Error cancelling reservation");
            return;
          }

          // Update the row without refreshing the page
          const row = document.querySelector('tr[data-id="' + id + '"]');
          row.querySelector(".status-cell").textContent = "Cancelled";
          const cell = this.parentElement;
          cell.innerHTML = '<button class="btn btn-sm btn-outline-secondary" disabled>Cancelled</button>';
        } catch (err) {
          alert("Network error, please try again.");
        }
      });
    });
  </script>
</body>
</html>